#!/bin/bash
# Demo web tier: nginx on ${app_port} answering /health. Replace with your application bootstrap.
# Rendered by environments/<env>/ec2/main.tf with templatefile: placeholders in dollar-brace form are filled by Terraform.
# Keep shell variables out of that form (write them without braces, or escape the dollar sign by doubling it).
set -euo pipefail

dnf install -y nginx

# The app reads the database location from here. The secret itself is fetched at runtime from Secrets Manager.
mkdir -p /etc/app
cat > /etc/app/app.env <<ENV
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_SECRET_ARN=${db_secret_arn}
ENV

cat > /etc/nginx/conf.d/app.conf <<CONF
server {
  listen ${app_port};
  location /health { return 200 "ok\n"; }
  location / { return 200 "shop web tier\n"; }
}
CONF

systemctl enable --now nginx
